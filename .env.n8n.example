# Copy to .env.n8n (git-ignored) and fill in. Read by docker-compose.yml.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Encrypts credentials stored inside n8n. Set once and keep it; changing it breaks saved credentials.
N8N_ENCRYPTION_KEY=

# Convex -> n8n: verifies the signature on loan events. Must equal LENDLOOP_TO_N8N_SECRET in Convex.
LENDLOOP_TO_N8N_SECRET=

# n8n -> Convex: signs calls to the Convex HTTP API. Must equal N8N_TO_LENDLOOP_SECRET in Convex.
N8N_TO_LENDLOOP_SECRET=

# Convex HTTP actions base URL (ends in .convex.site, not .convex.cloud).
# Local Convex backend from inside Docker: http://host.docker.internal:3211
LENDLOOP_CONVEX_SITE_URL=
