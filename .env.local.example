# Next.js (copy to .env.local). `npx convex dev` fills in the two CONVEX lines for you.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk: Dashboard -> API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ------------------------------------------------------------------------------------------
# The variables below are NOT read by Next.js. They are Convex environment variables:
# set them with `npx convex env set NAME value` (or in the Convex dashboard). Listed here so
# all configuration is documented in one place.
#
# CLERK_JWT_ISSUER_DOMAIN=https://<your-instance>.clerk.accounts.dev
# ADMIN_EMAILS=you@example.com                    # verified emails that become admin on first sign-in
# N8N_REQUEST_WEBHOOK_URL=http://localhost:5678/webhook/lendloop-request
# LENDLOOP_TO_N8N_SECRET=<same value as in .env.n8n>
# N8N_TO_LENDLOOP_SECRET=<same value as in .env.n8n>
